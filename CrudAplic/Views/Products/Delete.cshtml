@model CrudAplic.Models.Product

<h1 class="mb-4">Изтриване на продукт</h1>

<div class="alert alert-danger">
    Сигурни ли сте, че искате да изтриете продукта: <strong>@Model.Name</strong>?
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Да, изтрий</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

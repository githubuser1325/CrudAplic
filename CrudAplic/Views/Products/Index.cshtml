@model IEnumerable<CrudAplic.Models.Product>

<h1 class="mb-4">Списък с продукти</h1>

<a asp-action="Create" class="btn btn-primary mb-3"> Добави нов продукт</a>


@if (!Model.Any())
{
    <p>Няма продукти.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Име</th>
                <th>Цена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price лв.</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">✏️ Редактирай</a>
                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">🗑️ Изтрий</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}
